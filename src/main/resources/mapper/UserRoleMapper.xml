<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hospital.mapper.UserRoleMapper">

    <!-- 根据用户ID查询角色ID -->
    <select id="selectRoleIdsByUserId" resultType="java.lang.Long">
        SELECT role_id
        FROM sys_user_role
        WHERE user_id = #{userId}
    </select>

    <!-- 批量添加用户角色关系 -->
    <insert id="insertBatch">
        INSERT INTO sys_user_role (user_id, role_id) VALUES
        <foreach collection="roleIds" item="roleId" separator=",">
            (#{userId}, #{roleId})
        </foreach>
    </insert>

    <!-- 根据用户ID删除用户角色关系 -->
    <delete id="deleteByUserId">
        DELETE FROM sys_user_role WHERE user_id = #{userId}
    </delete>

    <!-- 根据用户ID查询用户角色关系中的最小角色排序 -->
    <select id="selectMinRoleSortByUserId" resultType="java.lang.Integer">
        SELECT MIN(r.role_sort)
        FROM sys_role r
        INNER JOIN sys_user_role ur ON r.id = ur.role_id
        WHERE ur.user_id = #{userId}
    </select>

    <!-- 获取指定用户角色的个数 -->
    <select id="countUserRolesByCodes" resultType="int">
        SELECT COUNT(1)
        FROM sys_user_role ur
        INNER JOIN sys_role r ON ur.role_id = r.id
        WHERE ur.user_id = #{userId}
        AND r.role_code IN
        <foreach collection="roleCodes" item="code" open="(" separator="," close=")">
            #{code}
        </foreach>
    </select>
</mapper>